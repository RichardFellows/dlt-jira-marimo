# Copy this file to .dlt/secrets.toml and fill in your values.
# .dlt/secrets.toml is gitignored — never commit real credentials.

[sources.jira_agile]
pat_token = "your-jira-personal-access-token"
base_url = "https://your-internal-jira/"   # include trailing slash; Agile paths are absolute

# The existing issue-search pipeline (jira_pipeline.py) keeps its own section:
# [sources.jira_source]
# pat_token = "..."
# base_url = "..."
# jql_query = "project = ABC"
# fields = "summary,status,assignee"
# expand = "changelog"
